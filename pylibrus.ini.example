[global]

; Decide which messages should be sent.
; Possible values:
;   - unsent - messages that were not previously sent
;   - unread - meesages that were unread  
# send_message=unread

; If attachments should be forwarded with the message content
; Possible values: true, false
# fetch_attachments=true

; Name of sqlite DB file that will be used by pylibrus.
; File will be created if absent.
; Can be configured globally or per child
# db_name=pylibrus.sqlite

; How old messages should still be forwarded.
; Value 4 means that only messages younger than 4 days will be forwarded.
# max_age_of_sending_msg_days=4

; If Librus announcements ("ogloszenia") should be forwarded too, in addition to messages.
; Possible values: true, false
; Can be configured globally or per child (see fetch_announcements under [user:ChildName] below)
# fetch_announcements=true

; How old announcements should still be forwarded.
; Falls back to max_age_of_sending_msg_days if not set.
; NOTE: announcements have no per-item read/unread flag in Librus, so unlike messages
; they always behave as if send_message=unsent - they are forwarded once (based on this
; age window) and never re-sent, regardless of the send_message setting above.
# max_age_of_sending_announcement_days=4

; Should debug messages be enabled.
; Possible values: true, false
# debug=false

; This parameter tell pylibrus how long it should sleep
; between next Librus users so that new connection is not throttled
# sleep_between_librus_users=180

; This is example configuration for forwarding messages to email
[user:ChildName]
librus_user=
librus_pass=
; optional, if not set global db_name is used
;db_name=
; optional, overrides the global fetch_announcements setting for this child only
;fetch_announcements=true
smtp_user=
smtp_pass=
smtp_server=
smtp_port=587
; email_dest is comma separated list of emails that will receive messages from Librus
email_dest=

; This is example configuration for forwarding messages to webhook
#[user:ChildName2]
#librus_user=
#librus_pass=
#webhook=
#webhook_attachments_source=librus_link

; This is example configuration for forwarding messages to webhook with working attachments links via s3 bucket
; Links from s3 bucket will work for 7 days
; Please setup your bucket to auto-delete files after 7 days
#[user:ChildName3]
#librus_user=
#librus_pass=
#webhook=
#webhook_attachments_source=s3://my-school-bucket/pylibrus-attachments
#s3_region=eu-central-1
#s3_access_key_id=AKIAEXAMPLE
#s3_secret_access_key=your-secret-key
; Optional for temporary AWS credentials:
#s3_session_token=
; Optional for S3-compatible storage:
#s3_endpoint_url=
